APP_NAME="Kaleb's Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vdk_machanics
DB_USERNAME=root
DB_PASSWORD=

# The old MongoDB store, only read by `php artisan app:import-mongodb`.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI="mongodb+srv://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>"
MONGODB_DATABASE=vdk_machanics

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Scandit barcode scanning. Get a key at https://ssl.scandit.com/dashboard/
# Leave blank to fall back to manual / USB scanner entry only.
SCANDIT_LICENSE_KEY=

# Shop assistant AI, via OpenRouter. Get a key at https://openrouter.ai/settings/keys
# Leave blank and the assistant page says it is not set up yet.
# Free models (ending in :free) allow 50 requests a day, or 1000 once $10 of credit
# has been bought. Models are tried in order: the main one, then the fallbacks.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,openrouter/free
# Models that can see pictures, for matching a vehicle's 3D model to its photos.
OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free,thinkingmachines/inkling:free,openrouter/free

# Default account for `php artisan app:create-admin` and `app:delete-admin`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
